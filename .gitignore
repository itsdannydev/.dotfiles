# Ignore wallpapers
themes/wallpapers/*.jpg
themes/wallpapers/*.jpeg
themes/wallpapers/*.png
themes/wallpapers/*.webp

# default.png is YOUR login wallpaper, so it is ignored like every other wallpaper
# (changing it never touches git). Only the tiny placeholder is tracked: the installer
# copies it to default.png on a fresh install (see setup/install.sh).
!themes/wallpapers/default.placeholder.png

# Ignore state files
config/hypr/.state/

# Ignore current colour and accent
themes/accent.color
themes/colors.css

# Ignore style.css of waybar and wofi (dynamically made using base.css and update_theme.sh script)
config/waybar/style.css
config/wofi/style.css
